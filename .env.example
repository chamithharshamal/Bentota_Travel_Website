# ─────────────────────────────────────────────────────────────
# Bentota Smart Journeys — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for Cloudinary webhooks and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Firebase (client SDK) ────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin SDK (server only) ─────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key
# Keep the quotes around the private key and leave the \n characters as they are.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudinary ───────────────────────────────────────────────
# Cloudinary console → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# A SIGNED upload preset (Settings → Upload → Upload presets). See README.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=bsj_admin_signed

# ── Cloudflare Turnstile (booking form bot protection) ───────
# Optional in development. Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── SMS alerts (future phase — disabled by default) ─────────
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
