rules_version = '2';

// Bentota Smart Journeys — Firestore security rules
//
// All writes go through the Next.js API routes, which use the Admin SDK and
// validate every request. Browsers can only READ, and only when signed in as
// staff with the right role. The public website reads through the server.

service cloud.firestore {
  match /databases/{database}/documents {

    function role() {
      return request.auth != null && ('role' in request.auth.token)
        ? request.auth.token.role
        : '';
    }
    function isStaff() { return role() in ['admin', 'editor', 'agent']; }
    function canBookings() { return role() in ['admin', 'agent']; }
    function canContent() { return role() in ['admin', 'editor']; }

    match /bookings/{id} {
      allow read: if canBookings();
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if canBookings();
      allow write: if false;
    }

    match /destinations/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /routes/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /packages/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /media/{id} {
      allow read: if canContent();
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if role() == 'admin';
      allow write: if false;
    }

    // counters and anything else: server only
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
